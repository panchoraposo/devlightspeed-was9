{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.jdt.ls.java.home": "/home/user/jdk-25",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-17",
      "path": "/usr/lib/jvm/java-17-openjdk",
      "default": true
    },
    {
      "name": "JavaSE-25",
      "path": "/home/user/jdk-25"
    }
  ],
  "mta-core.analyzerPath": "/home/user/mta/linux-mta-cli",
  "mta-vscode-extension.analyzerPath": "/home/user/mta/linux-mta-cli",
  "mta-core.genai.enabled": true,
  "mta-core.genai.agentMode": true,
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "extensions.ignoreRecommendations": false,
  "files.exclude": {
    "**/target": true,
    "**/.cache": true
  },
  "files.watcherExclude": {
    "**/migrated-apps/**": true,
    "**/target/**": true
  },
  "java.import.exclusions": [
    "**/migrated-apps/**",
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**"
  ]
}
